BLINDLOG_SECRET=change-me-to-a-long-random-value
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recover_net
WEBHOOK_SECRET=change-me-to-a-long-random-value

# AWS Bedrock — OpenAI-compatible endpoint
# Generate a bearer token via: aws bedrock create-model-invocation-api-key
# or use a short-lived SigV4 presigned token from boto3 (see docs/usage.md)
OPENAI_API_KEY=<your_bedrock_bearer_token_here>
OPENAI_BASE_URL=https://bedrock-mantle.<your-region>.api.aws/v1

# Model to use — must be enabled in your Bedrock region
BEDROCK_MODEL=mistral.ministral-3-8b-instruct
